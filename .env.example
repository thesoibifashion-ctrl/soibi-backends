# Live customer storefront URL. Used for customer tracking links and allowed by CORS.
LIVE_URL=

# Resend (email notifications)
RESEND_API_KEY=
NOTIFICATION_EMAIL=thesoibifashion@gmail.com
RESEND_FROM_EMAIL="Soibi Fasshion <orders@your-verified-domain.com>"

# Paystack
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
